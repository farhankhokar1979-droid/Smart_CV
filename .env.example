# Copy this file to .env and fill in your values.
# Everything works with no .env file at all — AI features just run on
# the offline rule-based fallback instead of Groq.

SECRET_KEY=change-this-to-a-random-string-in-production

# Free tier key from https://console.groq.com/keys
# Leave blank / omit to use the offline heuristic fallback only.
GROQ_API_KEY=

# Optional — defaults to llama-3.1-8b-instant
GROQ_MODEL=llama-3.1-8b-instant
